// Kundenkonten und Stempelkarte für das Orient-Grill-Bestellsystem.
// Bewusst getrennt vom essence-Backend (das bleibt DB-frei) — nur
// packages/core / apps/web-app greifen hierauf zu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id           String  @id @default(cuid())
  email        String  @unique
  /// null, wenn nur per Google angemeldet
  passwordHash String?
  googleId     String? @unique
  name         String?

  createdAt DateTime @default(now())

  /// Stempel seit der letzten Belohnung (0–4, bei 5 wird zurückgesetzt)
  stampCount      Int     @default(0)
  rewardAvailable Boolean @default(false)

  loyaltyEvents  LoyaltyEvent[]
  discountCodes  DiscountCode[]
  orders         Order[]
}

enum PaymentStatus {
  /// Wird bei der Abholung bezahlt — online ist nichts zu tun
  atPickup
  /// Online-Zahlung angelegt, Bestätigung steht aus
  pending
  /// Geld ist bestätigt
  paid
  /// Zahlung abgebrochen oder abgelehnt
  failed
}

/// Beleg einer abgeschickten Bestellung.
///
/// essence hält Bestellungen nur im Arbeitsspeicher und verliert sie
/// bei jedem Neustart. Diese Tabelle ist der bleibende Nachweis: was
/// hier steht, übersteht einen Neustart, ein neues Deployment und den
/// Ausfall von essence.
///
/// Der Beleg ist bewusst eine Momentaufnahme. Bezeichnungen und Preise
/// stehen so darin, wie sie beim Bestellen galten — eine später
/// geänderte Speisekarte darf einen alten Beleg nicht verfälschen.
model Order {
  /// Dieselbe Kennung, die essence vergeben hat
  id        String   @id
  createdAt DateTime @default(now())

  /// Zustand laut essence: created, ready, delivered
  status String

  name  String
  phone String
  note  String?

  /// selfPickup oder deliveryByCourier
  deliveryMethod String
  /// Bei Abholung nur die Kennung des Standorts, bei Lieferung die Anschrift
  address        Json?

  readyBy   String?
  readyType String?

  /// Gewählte Zahlungsart, z.B. cash, card oder online
  paymentMethodId String
  /// Rückgeld-Wunsch bei Barzahlung
  changeFrom      Float?

  paymentStatus PaymentStatus @default(atPickup)
  /// Kennung der Zahlung bei Stripe. Eindeutig, damit dieselbe Zahlung
  /// nicht zweimal abgeschlossen werden kann — die Bestätigung kommt
  /// sowohl aus dem Browser als auch per Webhook.
  stripePaymentId String? @unique

  totalPrice      Float
  discountPercent Int?

  /// Alle Positionen inklusive abgewählter Zutaten und bestellter
  /// Extras, genau so wie sie an die Küche gehen
  items Json

  /// Nur gesetzt, wenn der Gast angemeldet bestellt hat
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([createdAt])
}

/// Gutscheincode, der nach fünf Bestellungen erzeugt und per E-Mail
/// verschickt wird. Der Code selbst ist der Schlüssel — er wird beim
/// Bestellen eingegeben und danach entwertet.
model DiscountCode {
  id         String   @id @default(cuid())
  /// Der eingebbare Code, z.B. "ORIENT-4K7M-92XQ". Immer Großbuchstaben.
  code       String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// Rabatt in Prozent, zum Zeitpunkt der Ausstellung festgehalten —
  /// eine spätere Änderung der Aktion entwertet alte Codes nicht.
  discountPercent Int
  /// Mindestbestellwert in Euro, ebenfalls eingefroren
  minOrderValue   Int

  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Gesetzt, sobald der Code verbraucht ist
  redeemedAt DateTime?
  /// Bestellung, in der er eingelöst wurde
  redeemedOrderId String?

  /// Wurde die Benachrichtigung erfolgreich verschickt?
  emailSentAt DateTime?

  @@index([customerId])
}

enum LoyaltyEventType {
  stamp
  rewardEarned
  rewardRedeemed
}

model LoyaltyEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// Bestell-ID aus essence — rein informativ, essence kennt diese Tabelle nicht
  orderId String
  type    LoyaltyEventType

  createdAt DateTime @default(now())

  @@index([customerId])
}
