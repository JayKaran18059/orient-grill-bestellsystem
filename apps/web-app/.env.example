# Session password for Nuxt Auth Utils
NUXT_SESSION_PASSWORD=""

# Postgres-Verbindung (z.B. Vercel Postgres/Neon) für Kundenkonten und Stempelkarte
DATABASE_URL=""

# Google OAuth für "Mit Google anmelden" — Zugangsdaten aus der Google Cloud Console
# Redirect-URI dort eintragen: <domain>/api/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=""
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=""

# E-Mail-Versand der Gutscheincodes (resend.com).
# Bleibt der Schlüssel leer, werden Codes zwar erzeugt und im Kundenkonto
# angezeigt, aber nicht verschickt — die Bestellung läuft trotzdem durch.
# Der Absender muss eine bei Resend verifizierte Domain sein. Ohne eigene
# Domain funktioniert nur der Testabsender an die eigene Adresse.
NUXT_RESEND_API_KEY=""
NUXT_MAIL_ABSENDER="Orient Grill <bestellung@example.de>"

# Adresse des Shops. Wird in E-Mails verlinkt und ist die Adresse, zu der
# Stripe den Gast nach dem Bezahlen zurückschickt — ohne sie lässt sich
# nicht online bezahlen.
NUXT_PUBLIC_SITE_URL="https://orient-grill-bestellung.vercel.app"

# Online-Zahlung über Stripe (Karte, Apple Pay, Google Pay, PayPal).
#
# Bleiben diese Felder leer, verschwindet "Jetzt online bezahlen" aus der
# Kasse und es bleibt beim Bezahlen bei der Abholung. Nichts geht kaputt.
#
# Zu finden im Stripe-Dashboard unter Entwickler → API-Schlüssel. Zum
# Ausprobieren die Testschlüssel nehmen (pk_test_… / sk_test_…) — damit
# fließt kein echtes Geld, Testkarte 4242 4242 4242 4242.
#
# Der geheime Schlüssel gehört NUR hierher und zu Vercel, niemals in eine
# Datei im Projekt und niemals in einen Commit.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NUXT_STRIPE_SECRET_KEY=""

# Geheimnis des Webhooks, aus Stripe-Dashboard → Entwickler → Webhooks.
# Dort einen Endpunkt anlegen mit der Adresse
#   <NUXT_PUBLIC_SITE_URL>/api/payment/webhook
# und dem Ereignis "checkout.session.completed".
#
# Ohne dieses Geheimnis geht eine Bestellung verloren, wenn der Gast
# direkt nach dem Bezahlen den Browser schließt.
NUXT_STRIPE_WEBHOOK_SECRET=""

# URL to external API and Authorization Token
NUXT_API_URL=""
NUXT_API_TOKEN=""

# Id to get data
NUXT_PUBLIC_CHANNEL_ID=""

# If there are several storefronts on one domain - use path
# NUXT_APP_BASE_URL="/some-path"

# App version
VERSION=""
